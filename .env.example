# Copy to .env and fill in. Do not commit real values.
# YAML under hugginggpt/server/configs/ uses ${VAR} placeholders.
#
# jarvis_core has its own example: jarvis_core/.env.example
# (MQTT_USERNAME, MQTT_PASSWORD, JARVIS_HMAC_KEY, OLLAMA_BASE_URL, JARVIS_CONFIG).

# --- LLM ---
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# HF_TOKEN=hf_...
# HUGGINGFACE_ACCESS_TOKEN=

# --- Email & voice ---
# GMAIL_APP_PASSWORD=
# ELEVENLABS_API_KEY=

# --- Legacy HTTP bridges ---
# Read by config.default.yaml (integrations.*.token) and passed by
# run_jarvis.ps1 to each bridge as its BRIDGE_TOKEN.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JARVIS_PHONE_BRIDGE_TOKEN=
# JARVIS_COMPUTER_BRIDGE_TOKEN=
# BRIDGE_TOKEN=
# BRIDGE_DRY_RUN=true
# PHONE_HTTP_TOKEN=
# RELAY_URL=ws://localhost:8093
# RELAY_TOKEN=
# RELAY_REQ_TIMEOUT=45
# AGENT_ID=ian-phone
# JARVIS_SERVER=http://localhost:8004
# JARVIS_STT=google
# JARVIS_TTS=auto

# --- jarvis_prod MQTT (draft) ---
# JARVIS_BROKER=
# JARVIS_PORT=1883
# JARVIS_USER=
# JARVIS_PASS=
# JARVIS_NODE_ID=ian-phone
# JARVIS_CA_CERT=

# --- Chimera / jarvis_core HMAC (node SDK + jarvis_core) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# JARVIS_HMAC_KEY=

# --- Telegram gateway (jarvis_prod, optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DM_ALLOWLIST=12345,67890

# --- Langfuse (optional; no-op if unset) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
