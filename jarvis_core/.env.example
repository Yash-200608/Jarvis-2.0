# Copy to .env and fill in. Loaded automatically by core/config.py.

# Mosquitto credentials (leave blank for anonymous brokers).
MQTT_USERNAME=
MQTT_PASSWORD=

# 32-byte HMAC key shared between PC brain and Termux executor.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JARVIS_HMAC_KEY=

# Optional override for Ollama if it lives on a different host.
OLLAMA_BASE_URL=

# Path to the YAML config (defaults to ./configs/jarvis_core.yaml).
JARVIS_CONFIG=
