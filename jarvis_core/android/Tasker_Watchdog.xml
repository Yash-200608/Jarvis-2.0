<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  ============================================================================
  Jarvis-Core Tasker Watchdog
  ----------------------------------------------------------------------------
  Import this file in Tasker:  Menu > Data > Restore > Profiles
  Then long-press the imported profile and toggle it ON.

  What it does
    1. Every 10 minutes, fires the "Jarvis Watchdog" task.
    2. The task acquires termux-wake-lock so Doze mode cannot kill the
       Termux session.
    3. It runs `pgrep -f phone_executor.py` via Termux:Tasker.
    4. If %stdout is EMPTY (no PID returned) it considers the executor dead
       and relaunches it via `bash ~/jarvis-core/start_phone_executor.sh`.
    5. Sends a Tasker notification on every restart so the user can see if
       it's been crash-looping.

  Prerequisites
    - Termux + Termux:API + Termux:Tasker installed (F-Droid builds, NOT
      Play Store — the latter cannot talk to each other).
    - Tasker grant: long-press the Termux:Tasker action in Tasker, then
      "Configure" -> point at the script `start_phone_executor.sh` placed in
      ~/.termux/tasker/.
    - The script itself simply does:
          #!/data/data/com.termux/files/usr/bin/bash
          cd ~/jarvis-core
          nohup python phone_executor.py --config phone.yaml \
              >> ~/jarvis-core/phone.log 2>&1 &
  ============================================================================
-->
<TaskerData sr="" dvi="1" tv="6.3.13">

  <!-- ============================================================ -->
  <!-- PROFILE: every 10 minutes from 00:00, all day, all week     -->
  <!-- ============================================================ -->
  <Profile sr="prof1" ve="2">
    <cdate>1700000000000</cdate>
    <edate>1700000000000</edate>
    <id>1</id>
    <mid>1</mid>
    <nme>Jarvis Watchdog</nme>
    <Time sr="conTime0">
      <fh>0</fh>
      <fm>0</fm>
      <th>23</th>
      <tm>59</tm>
      <rep>true</rep>
      <repval>10</repval>     <!-- repeat every 10 minutes -->
      <repunit>1</repunit>    <!-- 1 = minutes -->
    </Time>
  </Profile>

  <!-- ============================================================ -->
  <!-- TASK 1: Jarvis Watchdog                                      -->
  <!--   step 1: acquire wake-lock                                  -->
  <!--   step 2: pgrep phone_executor.py                            -->
  <!--   step 3: branch — if PID list empty, relaunch + notify     -->
  <!-- ============================================================ -->
  <Task sr="task1">
    <cdate>1700000000000</cdate>
    <edate>1700000000000</edate>
    <id>1</id>
    <nme>Jarvis Watchdog</nme>

    <!-- 1) Acquire wake-lock so Termux survives Doze. -->
    <Action sr="act0" ve="7">
      <code>525</code>                 <!-- "Run Shell" -->
      <Str sr="arg0" ve="3">termux-wake-lock</Str>
      <Int sr="arg1"><val>0</val></Int>      <!-- timeout 0 = no limit -->
      <Int sr="arg2"><val>1</val></Int>      <!-- run as root: false -->
      <Int sr="arg3"><val>1</val></Int>      <!-- store result in vars -->
      <Str sr="arg4" ve="3">%wl_out</Str>
      <Str sr="arg5" ve="3">%wl_err</Str>
      <Str sr="arg6" ve="3">%wl_res</Str>
    </Action>

    <!-- 2) Probe for phone_executor.py via Termux:Tasker plugin. -->
    <Action sr="act1" ve="7">
      <code>129</code>                 <!-- "Plugin" action -->
      <Bundle sr="arg0">
        <Vals sr="val">
          <com.termux.tasker.extra.COMMAND_PATH>tasker/probe_phone_executor.sh</com.termux.tasker.extra.COMMAND_PATH>
          <com.termux.tasker.extra.COMMAND_BACKGROUND>true</com.termux.tasker.extra.COMMAND_BACKGROUND>
          <com.termux.tasker.extra.STDIN/>
          <com.termux.tasker.extra.WORKDIR>/data/data/com.termux/files/home</com.termux.tasker.extra.WORKDIR>
        </Vals>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.EditConfigurationActivity</Str>
      <Int sr="arg3"><val>1</val></Int>
    </Action>

    <!-- 2b) Wait briefly for the plugin to populate %stdout. -->
    <Action sr="act2" ve="7">
      <code>30</code>                  <!-- "Wait" -->
      <Int sr="arg0"><val>0</val></Int>      <!-- hours -->
      <Int sr="arg1"><val>0</val></Int>      <!-- minutes -->
      <Int sr="arg2"><val>3</val></Int>      <!-- seconds -->
      <Int sr="arg3"><val>0</val></Int>      <!-- ms -->
    </Action>

    <!-- 3) IF stdout is empty, executor is dead — relaunch + notify. -->
    <Action sr="act3" ve="7">
      <code>37</code>                  <!-- "If" -->
      <ConditionList sr="if">
        <Condition sr="c0" ve="3">
          <lhs>%stdout</lhs>
          <op>3</op>                   <!-- "is empty" -->
          <rhs></rhs>
        </Condition>
      </ConditionList>
    </Action>

    <!-- 3a) Relaunch via Termux:Tasker plugin. -->
    <Action sr="act4" ve="7">
      <code>129</code>                 <!-- "Plugin" -->
      <Bundle sr="arg0">
        <Vals sr="val">
          <com.termux.tasker.extra.COMMAND_PATH>tasker/start_phone_executor.sh</com.termux.tasker.extra.COMMAND_PATH>
          <com.termux.tasker.extra.COMMAND_BACKGROUND>true</com.termux.tasker.extra.COMMAND_BACKGROUND>
          <com.termux.tasker.extra.STDIN/>
          <com.termux.tasker.extra.WORKDIR>/data/data/com.termux/files/home/jarvis-core</com.termux.tasker.extra.WORKDIR>
        </Vals>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.EditConfigurationActivity</Str>
      <Int sr="arg3"><val>1</val></Int>
    </Action>

    <!-- 3b) Buzz the user so crash-looping is visible. -->
    <Action sr="act5" ve="7">
      <code>523</code>                 <!-- "Notify" -->
      <Str sr="arg0" ve="3">Jarvis-Core</Str>
      <Str sr="arg1" ve="3">phone_executor.py was down — restarted</Str>
      <Img sr="arg2" ve="2"><nme>cust_notification</nme></Img>
      <Int sr="arg3"><val>1</val></Int>
      <Int sr="arg4"><val>0</val></Int>
    </Action>

    <!-- end if -->
    <Action sr="act6" ve="7">
      <code>38</code>                  <!-- "End If" -->
    </Action>
  </Task>
</TaskerData>
